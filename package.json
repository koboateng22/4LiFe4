{
  "name": "4life",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx dev-server.ts --port 3000",
    "build": "vite build && esbuild dev-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:seed-demo": "ALLOW_DEMO_SEED=yes node scripts/seed-demo.mjs",
    "db:remove-demo": "node scripts/remove-demo.mjs",
    "ai:check": "tsx scripts/check-ai.ts",
    "test:unit": "tsx scripts/unit-test.ts",
    "test:integration": "tsx scripts/integration-test.ts",
    "test:emergency": "tsx scripts/emergency-unit-test.ts && tsx scripts/emergency-db-test.ts",
    "test:emergency:e2e": "tsx scripts/emergency-e2e.ts",
    "test:mobile": "tsx scripts/mobile-e2e.ts",
    "test:signup-age": "tsx scripts/signup-age-test.ts",
    "test:theme": "tsx scripts/theme-e2e.ts",
    "test:account-db": "tsx scripts/account-db-test.ts",
    "test:schedule-db": "tsx scripts/schedule-db-test.ts",
    "test:privacy-db": "tsx scripts/privacy-db-test.ts",
    "test:admin-db": "tsx scripts/admin-db-test.ts",
    "test:therapist-schedule": "tsx scripts/therapist-schedule-e2e.ts",
    "test:demo-build": "tsx scripts/demo-build-test.ts",
    "test:learn": "tsx scripts/learn-e2e.ts",
    "test:chat": "tsx scripts/chat-e2e.ts",
    "test:ai-backend": "tsx scripts/ai-backend-e2e.ts",
    "test:privacy": "tsx scripts/privacy-e2e.ts",
    "test:admin": "tsx scripts/admin-e2e.ts",
    "test:sidebar": "tsx scripts/sidebar-e2e.ts",
    "test:auth-redirect": "tsx scripts/auth-redirect-e2e.ts",
    "i18n:extract": "tsx scripts/i18n-extract.ts",
    "test:i18n": "tsx scripts/i18n-check.ts",
    "test:i18n:e2e": "tsx scripts/i18n-e2e.ts",
    "sync:functions": "node scripts/sync-functions.mjs",
    "functions:check": "node scripts/sync-functions.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.180.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
