{
  "name": "4life",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx dev-server.ts --port 3000",
    "build": "vite build && esbuild dev-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "ai:check": "node scripts/check-gemini.mjs",
    "test:unit": "tsx scripts/unit-test.ts",
    "test:integration": "tsx scripts/integration-test.ts",
    "sync:functions": "node scripts/sync-functions.mjs",
    "functions:check": "node scripts/sync-functions.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.180.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
