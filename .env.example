# ---------------------------------------------------------------------
# 4Life settings. Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------

# ---------- AI companion (server only — never in a VITE_ variable) ------
# Groq answers first; Gemini takes over automatically when Groq is busy, down, rate-limited or
# out of quota. Both have free tiers. Test both with: npm run ai:check
# Groq key: https://console.groq.com/keys      Your free limits: https://console.groq.com/settings/limits
GROQ_API_KEY="MY_GROQ_API_KEY"
# Optional: Groq model. Default openai/gpt-oss-120b. Models: https://console.groq.com/docs/models
GROQ_MODEL=
# Gemini key: https://aistudio.google.com/apikey   Free limits: https://aistudio.google.com/rate-limit
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: Gemini model. Default gemini-3.5-flash-lite (fast, on the free tier); gemini-3.8-flash is also free.
GEMINI_MODEL=
# Optional: the order (defaults shown). FALLBACK_AI_PROVIDER=none switches the fallback off.
PRIMARY_AI_PROVIDER=groq
FALLBACK_AI_PROVIDER=gemini

# Where the app is hosted (used for links in emails).
APP_URL="http://localhost:3000"

# Optional Google Maps key. Without it the map uses OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=

# ---------- Sign-in links ----------------------------------------------
# The public 4Life address. Email links (confirm, reset password) and Google sign-in always come
# back to <this address>/auth/callback, unless the person is already on an allowed 4Life address.
VITE_APP_URL=https://4lifeee.vercel.app
# Optional: more addresses sign-in may come back to (comma separated, e.g. a preview address).
# localhost:3000 and localhost:5173 are always allowed. Add the same addresses in Supabase (SUPABASE.md, section 1).
VITE_AUTH_REDIRECT_ORIGINS=

# ---------- Supabase (optional) --------------------------------------
# Leave these empty to run in "device mode" (data stays in the browser).
# Project Settings → API in the Supabase dashboard:
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# The public "anon" (or "publishable") key. Safe to ship in the browser.
VITE_SUPABASE_ANON_KEY=<your-anon-public-key> 

# Demo accounts and sample data (demo client, demo therapist, sample clients and posts).
# Always on in `npm run dev`. In a build only with "true": set it for PREVIEW deployments only,
# never for production. Without it, a production build contains no demo data at all.
VITE_ENABLE_DEMO=

# Sign in with Google / with a text message code (Supabase only). Set to "true" only after the
# set-up in SUPABASE.md, section 6, or the buttons would just fail.
VITE_AUTH_GOOGLE=
VITE_AUTH_PHONE=

# Learn videos: YouTube quota units this server may spend per day (default 6000 of Google's 10000)
VIDEO_DAILY_UNITS=

# Server: refuse /api calls from people who are not signed in.
REQUIRE_SIGN_IN=false

# Only for scripts/seed-demo.mjs — NEVER expose this in the app or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where "Ask the developers" sends feedback (opens the person's email app)
VITE_FEEDBACK_EMAIL=""

# --- Privacy Policy (/privacy): who runs 4Life. Shown on the public policy page. ---
# Until these are set, the page shows a marked placeholder ("to be added"); it never invents them.
# These are public details (they appear on the page), not secrets. Redeploy after changing them.
VITE_PRIVACY_OPERATOR=""
VITE_PRIVACY_EMAIL=""
VITE_PRIVACY_ADDRESS=""
# Optional: a named data protection contact, and the Data Protection Commission registration number
VITE_PRIVACY_DPO=""
VITE_PRIVACY_DPC_REGISTRATION=""

# Instant EMS has no dispatch or SMS provider, so it needs no keys: see EMERGENCY.md.
# Instant EMS map services (optional). Free public OpenStreetMap servers are used by default.
# For a big launch, use your own or a paid server, because the public ones are for light use.
# VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# VITE_OSRM_URL=https://router.project-osrm.org/route/v1/driving

# ---------- First aid videos (optional) -------------------------------
# YouTube Data API v3 key. Server only — never put it in a VITE_ variable.
# Without it, each first aid topic opens a YouTube search instead.
# Get one: Google Cloud console → APIs & Services → enable "YouTube Data API v3" → Credentials.
YOUTUBE_API_KEY=

# ---------- API protection (optional) --------------------------------
# Other sites allowed to call /api (comma separated). Not needed for the web app itself.
ALLOWED_ORIGINS=
# AI requests allowed per visitor per minute (default 30)
RATE_LIMIT_PER_MINUTE=
# Set to "supabase" to call the Supabase Edge Functions first instead of /api (see SUPABASE.md, section 5)
VITE_API_BACKEND=
