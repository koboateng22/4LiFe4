# ---------------------------------------------------------------------
# 4Life settings. Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------

# Gemini (AI companion). Server only — never put it in a VITE_ variable.
# Free key: https://aistudio.google.com/apikey   Test it: npm run ai:check
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: which model to use (default gemini-3.8-flash; cheaper: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Where the app is hosted (used for links in emails).
APP_URL="http://localhost:3000"

# Optional Google Maps key. Without it the map uses OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=

# ---------- Supabase (optional) --------------------------------------
# Leave these empty to run in "device mode" (data stays in the browser).
# Project Settings → API in the Supabase dashboard:
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# The public "anon" (or "publishable") key. Safe to ship in the browser.
VITE_SUPABASE_ANON_KEY=<your-anon-public-key> 

# Server: refuse /api calls from people who are not signed in.
REQUIRE_SIGN_IN=false

# Only for scripts/seed-demo.mjs — NEVER expose this in the app or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where "Ask the developers" sends feedback (opens the person's email app)
VITE_FEEDBACK_EMAIL=""

# Instant EMS map services (optional). Free public OpenStreetMap servers are used by default.
# For a big launch, use your own or a paid server, because the public ones are for light use.
# VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# VITE_OSRM_URL=https://router.project-osrm.org/route/v1/driving

# ---------- First aid videos (optional) -------------------------------
# YouTube Data API v3 key. Server only — never put it in a VITE_ variable.
# Without it, each first aid topic opens a YouTube search instead.
# Get one: Google Cloud console → APIs & Services → enable "YouTube Data API v3" → Credentials.
YOUTUBE_API_KEY=

# ---------- API protection (optional) --------------------------------
# Other sites allowed to call /api (comma separated). Not needed for the web app itself.
ALLOWED_ORIGINS=
# AI requests allowed per visitor per minute (default 30)
RATE_LIMIT_PER_MINUTE=
# Set to "supabase" to call the Supabase Edge Functions first instead of /api (see SUPABASE.md, section 5)
VITE_API_BACKEND=
# Optional: OpenAI is used only when there is no Gemini key. Server only.
OPENAI_API_KEY=
OPENAI_MODEL=
